{
  "name": "@thebuilder/delivery-api-inspector-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run generate:demo && blume dev",
    "build": "pnpm run generate:brand && pnpm run generate:og && pnpm run generate:demo && blume build",
    "check": "blume check",
    "generate:brand": "node scripts/generate-brand.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "generate:og": "umbraco-docs-og",
    "check:og": "umbraco-docs-og --check",
    "generate:demo": "pnpm --dir ../../src/TheBuilder.DeliveryApiInspector/Client build:demo"
  },
  "dependencies": {
    "@thebuilder/umbraco-docs": "^1.7.0",
    "blume": "^2.2.7",
    "vgpu": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5"
  }
}
