<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageId>TheBuilder.DeliveryApiInspector</PackageId>
    <Product>Delivery API Inspector for Umbraco</Product>
    <Title>See a document's Delivery API output in the Umbraco backoffice</Title>
    <!-- The local fallback. A release sets the version from its tag. -->
    <Version>0.1.0</Version>
    <Authors>Daniel Schmidt</Authors>
    <Description>An API tab on every document and media item that shows exactly what the Umbraco Delivery API returns for it, with search, expand and fields, and a diff of draft against published.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;delivery-api;headless;json;developer-tools</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thebuilder/umbraco-delivery-api-inspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/umbraco-delivery-api-inspector.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/thebuilder/umbraco-delivery-api-inspector/releases for release notes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <BackofficeClientDirectory>$(MSBuildProjectDirectory)/Client</BackofficeClientDirectory>
    <BackofficeAssetsPattern>wwwroot/App_Plugins/TheBuilder.DeliveryApiInspector/**/*</BackofficeAssetsPattern>
    <BackofficeAssetsDirectory>$(MSBuildProjectDirectory)/wwwroot/App_Plugins/TheBuilder.DeliveryApiInspector</BackofficeAssetsDirectory>
    <BackofficeManifest>$(BackofficeAssetsDirectory)/umbraco-package.json</BackofficeManifest>
    <BackofficeEntryPoint>$(BackofficeAssetsDirectory)/delivery-api-inspector.js</BackofficeEntryPoint>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Delivery" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <!-- Security floors for dependencies inherited from the supported Umbraco range. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Client\**" />
    <Content Remove="wwwroot/App_Plugins/TheBuilder.DeliveryApiInspector/**/*" />
    <None Include="Client\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot/App_Plugins/TheBuilder.DeliveryApiInspector/" />
  </ItemGroup>
  <!-- The backoffice client (Client/) is built while packing, with the package's version in the
       manifest Umbraco reads, and its output packed as static web assets under App_Plugins. -->
  <Target Name="BuildBackofficeAssetsForPack" Condition="'$(_IsPacking)' == 'true' and '$(NoBuild)' != 'true'">
    <Exec Command="corepack pnpm build" WorkingDirectory="$(BackofficeClientDirectory)" EnvironmentVariables="PACKAGE_VERSION=$(Version)" />
  </Target>
  <Target Name="RefreshBackofficeStaticWebAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BuildBackofficeAssetsForPack">
    <ItemGroup><Content Include="$(BackofficeAssetsPattern)" /></ItemGroup>
  </Target>
  <Target Name="ValidateBackofficeAssetsForPack" BeforeTargets="IncludeStaticWebAssetsPackItems" Condition="'$(_IsPacking)' == 'true'">
    <Error Condition="!Exists('$(BackofficeManifest)')" Text="Cannot pack TheBuilder.DeliveryApiInspector because the backoffice manifest is missing." />
    <Error Condition="!Exists('$(BackofficeEntryPoint)')" Text="Cannot pack TheBuilder.DeliveryApiInspector because the backoffice entry point is missing." />
  </Target>
</Project>
