{
  "name": "thebuilder-delivery-api-inspector",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "tsc && vite build --watch",
    "build:demo": "vite build --config vite.demo.config.ts",
    "demo:capture": "node demo/capture.mjs"
  },
  "devDependencies": {
    "@umbraco-cms/backoffice": "17.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.13.1"
}
